{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "#core/*":   ["./src/core/*.ts"],
      "#drivers/*": ["./src/drivers/*"],
      "#client/*": ["./src/client/*.ts"],
      "#kernel/*": ["./src/kernel/*.ts"],
      "#manyapi":  ["./src/kernel/pluginApi.ts"],
      "#settingsdb": ["./src/kernel/settingsDb.ts"],
      "#sendguard":  ["./src/kernel/sendGuard.ts"],
      "#logger":   ["./src/logger/logger.ts"],
      "#utils/*":  ["./src/utils/*.ts"],
      "#i18n":     ["./src/i18n/index.ts"],
      "#download": ["./src/download/queue.ts"],
      "#config":   ["./src/config.ts"],
      "#main":     ["./src/main.ts"],
      "#types":    ["./src/types.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
