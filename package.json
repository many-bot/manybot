{
  "name": "@manybot/manybot",
  "description": "Free and open source WhatsApp bot",
  "author": {
    "name": "SyntaxError!",
    "email": "me@stxerr.dev"
  },
  "version": "5.1.0",
  "license": "GPL-3.0-only",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/many-bot/manybot.git"
  },
  "type": "module",
  "bin": {
    "manybot": "./src/main.ts"
  },
  "files": [
    "src/client",
    "src/config.js",
    "src/download",
    "src/i18n",
    "src/kernel",
    "src/locales",
    "src/logger",
    "src/main.js",
    "src/utils",
    "README.md",
    "README_EN.md",
    "latest",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.23",
    "better-sqlite3": "^12.11.1",
    "node-webpmux": "^3.2.1",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.7.0"
  },
  "imports": {
    "#client/*": "./src/client/*.ts",
    "#kernel/*": "./src/kernel/*.ts",
    "#manyapi": "./src/kernel/pluginApi.ts",
    "#settingsdb": "./src/kernel/settingsDb.ts",
    "#sendguard": "./src/kernel/sendGuard.ts",
    "#logger": "./src/logger/logger.ts",
    "#utils/*": "./src/utils/*.ts",
    "#i18n": "./src/i18n/index.ts",
    "#download": "./src/download/queue.ts",
    "#config": "./src/config.ts",
    "#main": "./src/main.ts",
    "#types": "./src/types.ts"
  }
}
