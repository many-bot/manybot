{
  "name": "@manybot/manybot",
  "description": "Free and open source WhatsApp bot",
  "author": {
    "name": "SyntaxError!",
    "email": "me@stxerr.dev"
  },
  "version": "5.4.0",
  "license": "GPL-3.0-only",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/many-bot/manybot.git"
  },
  "type": "module",
  "bin": {
    "manybot": "dist/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm i && tsc && node -e \"fs.mkdirSync('dist/locales', { recursive: true }); fs.cpSync('src/locales', 'dist/locales', { recursive: true });\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.23",
    "node-cron": "^4.6.0",
    "node-webpmux": "^3.2.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.7.0"
  },
  "imports": {
    "#drivers/*": "./dist/drivers/*",
    "#core/*": "./dist/core/*",
    "#client/*": "./dist/client/*",
    "#kernel/*": "./dist/kernel/*",
    "#manyapi": "./dist/kernel/pluginApi.js",
    "#settingsdb": "./dist/kernel/settingsDb.js",
    "#sendguard": "./dist/kernel/sendGuard.js",
    "#logger": "./dist/logger/logger.js",
    "#utils/*": "./dist/utils/*",
    "#i18n": "./dist/i18n/index.js",
    "#download": "./dist/download/queue.js",
    "#config": "./dist/config.js",
    "#main": "./dist/main.js",
    "#types": "./dist/types.js"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@6.7.23": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.4": true
  }
}
